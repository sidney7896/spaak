APP_ENV=development
# Build-stamped copy of APP_ENV. The browser bundle and the middleware cannot read APP_ENV, so this
# is what binds them to one environment as well as to one application; it must agree with APP_ENV.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_DB_SCHEMA=app_spaak_dev
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=app_spaak_dev
SUPABASE_STORAGE_BUCKET=spaak-dev-private
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=spaak-dev-private
# Schema map: development=app_spaak_dev, staging=app_spaak_stg, production=app_spaak_prod
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
NEXT_PUBLIC_POSTHOG_KEY=replace-with-public-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=replace-with-sentry-dsn
RESEND_API_KEY=replace-with-resend-key
